# Configuration & Local Locks
config.yaml
.instance.lock
*.zip

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.packaging-smoke/
.test-tmp-*/

# Database files (Local privacy storage)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.pkl
data/*
!data/.gitkeep

# Local Generated Reports & Checkpoints
# 報告與收據一律是本機產物（含 repo_sync/、handoffs/ 子目錄與
# acceptance/confirmations.json 這類使用者自己寫的確認附註），全部不進版控。
reports/**
!reports/.gitkeep
logs/*.log
logs/checkpoints/*.md
!logs/checkpoints/.gitkeep
scripts/.tz_migrated

# Environment variables & API keys
.env
.env.local

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
